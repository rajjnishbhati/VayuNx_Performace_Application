{
  "name": "@vayunx/profiler",
  "version": "0.3.0",
  "private": true,
  "description": "VAYUNX Crypto Profiler - Node.js / Next.js SDK on OpenTelemetry (spec F). Package name is provisional (decision D3); private until publishing is approved.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./register": { "types": "./dist/register.d.ts", "default": "./dist/register.js" },
    "./next": { "types": "./dist/next.d.ts", "default": "./dist/next.js" },
    "./edge": { "types": "./dist/edge.d.ts", "default": "./dist/edge.js" },
    "./package.json": "./package.json"
  },
  "bin": { "vayunx-node": "dist/cli.js" },
  "files": ["dist"],
  "engines": { "node": ">=20.11" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "argon2": "0.45.1",
    "bcrypt": "6.0.0",
    "bcryptjs": "3.0.3",
    "jsonwebtoken": "9.0.3",
    "typescript": "5.9.3"
  }
}
